# === Server Runut - contoh konfigurasi (tanpa nilai rahasia) ===
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Penyimpanan: memori (sementara) secara bawaan. Isi DATABASE_URL untuk
# menyimpan akun & sesi di PostgreSQL lokal. Skema tabel dibuat otomatis saat
# server pertama kali terhubung.
DATABASE_URL=

# Auth. Bila dikosongkan, server memakai kunci acak sementara (sesi tidak
# bertahan setelah restart). Isi untuk pemakaian sehari-hari, mis.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=1h
REFRESH_TOKEN_DAYS=30

# === AI provider: 9Router (endpoint kompatibel OpenAI) ===
# AI_MODEL wajib diisi dengan ID model yang benar-benar tersedia di dashboard
# 9Router. Tidak ada nilai bawaan supaya tidak ada ID model yang dikarang.
AI_PROVIDER=9router
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=10000

# === Premium (tampilan saja) ===
# Harga & masa aktif dipakai seragam oleh halaman Premium dan footer website.
# Pembayaran belum dibuka: /api/payments menjawab 501 dan tidak ada transaksi.
PREMIUM_PRICE_IDR=49000
PREMIUM_DURATION_DAYS=30

# Demo presentasi: 1 = akun baru langsung berstatus Premium (penyimpanan memori
# saja) supaya alur "terapkan saran" bisa diperlihatkan walau pembayaran belum
# dibuka. Kosongkan untuk perilaku normal (akun baru = gratis).
DEMO_PREMIUM=

# === Email reset password (SMTP) ===
# Tanpa ini endpoint forgot-password menjawab 503 eksplisit (bukan sukses palsu).
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Runut <no-reply@runut.local>
