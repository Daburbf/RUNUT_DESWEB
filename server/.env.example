# === Server Runut - contoh konfigurasi (tanpa nilai rahasia) ===
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Penyimpanan: memori (sementara) secara bawaan. Isi DATABASE_URL untuk
# menyimpan akun & sesi di PostgreSQL lokal. Skema tabel dibuat otomatis saat
# server pertama kali terhubung.
DATABASE_URL=

# Auth. Bila dikosongkan, server memakai kunci acak sementara (sesi tidak
# bertahan setelah restart). Isi untuk pemakaian sehari-hari, mis.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=1h
REFRESH_TOKEN_DAYS=30

# === AI provider: 9Router (endpoint kompatibel OpenAI) ===
# AI_MODEL wajib diisi dengan ID model yang benar-benar tersedia di dashboard
# 9Router. Tidak ada nilai bawaan supaya tidak ada ID model yang dikarang.
AI_PROVIDER=9router
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=10000

# === Premium ===
# Harga & masa aktif dipakai seragam oleh halaman Premium dan footer website.
# Premium tidak dibatasi jumlah kata; batas praktis satu dokumen 200.000 karakter.
PREMIUM_PRICE_IDR=49000
PREMIUM_DURATION_DAYS=30

# === Payment gateway (Midtrans) ===
# Tanpa MIDTRANS_SERVER_KEY: di luar produksi server memakai mode SIMULASI
# (transaksi bisa ditandai lunas lewat tombol uji di halaman Premium), di
# produksi pembelian ditutup (503) supaya tidak ada Premium aktif tanpa
# pembayaran nyata. Isi kunci untuk memakai gateway asli.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Kosong = otomatis (sandbox/produksi mengikuti MIDTRANS_IS_PRODUCTION).
MIDTRANS_API_BASE=
# Acquirer QRIS di Midtrans: gopay atau airpay shopee.
MIDTRANS_QRIS_ACQUIRER=gopay
# Masa berlaku transaksi sebelum ditandai kedaluwarsa.
PAYMENT_EXPIRY_HOURS=24

# Demo presentasi: 1 = akun baru langsung berstatus Premium (penyimpanan memori
# saja, tidak berlaku saat NODE_ENV=test). Kosongkan untuk menguji alur
# pembayaran yang sebenarnya (akun baru = gratis).
DEMO_PREMIUM=

# === Email reset password (SMTP) ===
# Tanpa ini endpoint forgot-password menjawab 503 eksplisit (bukan sukses palsu).
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Runut <no-reply@runut.local>
