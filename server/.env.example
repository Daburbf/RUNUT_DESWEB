# === Server Runut ===
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL 14+ (wajib untuk jalan normal; lihat README untuk setup)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/runut

# Auth (wajib diisi; generate acak, mis. via `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_ACCESS_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_REFRESH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30

# === AI provider (aktif pertama: 9Router, OpenAI-compatible) ===
AI_PROVIDER=9router
AI_BASE_URL=https://api.9router.com/v1
AI_API_KEY=isi-api-key-9router-anda
AI_MODEL=isi-id-model-yang-tersedia-di-akun-anda
AI_TIMEOUT_MS=10000
# Alternatif lokal (tanpa tulis ulang kode, cukup ganti config):
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434
# AI_MODEL=qwen3.5
# AI_API_KEY tidak dipakai untuk Ollama

# === Midtrans (sandbox untuk dev; production untuk rilis) ===
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=isi-server-key-midtrans-anda
MIDTRANS_CLIENT_KEY=isi-client-key-midtrans-anda
PREMIUM_PRICE_IDR=49000
PREMIUM_DURATION_DAYS=30

# === Email reset password (SMTP; tanpa ini endpoint forgot-password balas 503 eksplisit) ===
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Runut <no-reply@runut.local>
