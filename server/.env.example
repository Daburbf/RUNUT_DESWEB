# === Server Runut — contoh konfigurasi (tanpa nilai rahasia) ===
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Penyimpanan tahap ini: memori (sementara). Tidak ada DATABASE_URL —
# PostgreSQL ditambahkan pada tahap berikutnya di server/src/repositories/.

# Auth. Bila dikosongkan, server memakai kunci acak sementara (sesi tidak
# bertahan setelah restart). Isi untuk pemakaian sehari-hari, mis.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=1h
REFRESH_TOKEN_DAYS=30

# === AI provider: 9Router (endpoint kompatibel OpenAI) ===
# AI_MODEL wajib diisi dengan ID model yang benar-benar tersedia di dashboard
# 9Router. Tidak ada nilai bawaan supaya tidak ada ID model yang dikarang.
AI_PROVIDER=9router
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=10000

# === Midtrans (QRIS, Core API /v2/charge) ===
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_QRIS_ACQUIRER=gopay
# Tarif premium tidak ditetapkan SRS/SDD. Kosongkan bila belum ditentukan —
# endpoint pembuatan transaksi akan menjawab 503 sampai diisi.
PREMIUM_PRICE_IDR=
PREMIUM_DURATION_DAYS=30

# === Email reset password (SMTP) ===
# Tanpa ini endpoint forgot-password menjawab 503 eksplisit (bukan sukses palsu).
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Runut <no-reply@runut.local>
